---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="max-w-3xl">
  <p class="atlas-eyebrow">{eyebrow}</p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
    {title}
  </h1>
  <p class="mt-3 text-lg text-muted-foreground">{description}</p>
</header>
