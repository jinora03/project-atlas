---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SystemMap from "@/components/atlas/SystemMap.astro";
import { buttonVariants } from "@/components/ui/button";
import {
  getConcepts,
  getDomains,
  getDecisions,
  getGuides,
} from "@/lib/content";

const [concepts, domains, decisions, guides] = await Promise.all([
  getConcepts(),
  getDomains(),
  getDecisions(),
  getGuides(),
]);

const entries = [
  {
    title: "Domains",
    href: "/domains",
    meta: `${domains.length} territories`,
    description:
      "Orient yourself in an area of engineering and the concepts relevant to it.",
    cta: "Browse domains",
  },
  {
    title: "Concepts",
    href: "/concepts",
    meta: `${concepts.length} concepts`,
    description:
      "Canonical explanations of the building blocks — how they work and how they fail.",
    cta: "Browse concepts",
  },
  {
    title: "Decisions",
    href: "/decisions",
    meta: `${decisions.length} guides`,
    description:
      "Should you use this thing? Weigh the trade-offs — and when not to.",
    cta: "Browse decisions",
  },
  {
    title: "Guides",
    href: "/guides",
    meta: `${guides.length} guide${guides.length === 1 ? "" : "s"}`,
    description:
      "Long-form, connected explanations that tie many concepts into one model.",
    cta: "Read guides",
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-4 pb-8 pt-12 sm:px-6 sm:pt-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div class="max-w-xl">
        <p class="atlas-eyebrow">An interactive atlas of software engineering</p>
        <h1
          class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl"
        >
          Software Engineering Atlas
        </h1>
        <p class="mt-5 text-lg text-muted-foreground">
          Understand how software systems fit together — where technologies and
          concepts belong, what they own, the problems they solve, and when their
          complexity is actually justified.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/systems-map"
            class={buttonVariants({ size: "lg" })}
          >
            Explore the Systems Map
          </a>
          <a
            href="/concepts"
            class={buttonVariants({ variant: "outline", size: "lg" })}
          >
            Browse concepts
          </a>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-muted/30 p-5 sm:p-6">
        <div class="mb-4 flex items-center justify-between">
          <span class="atlas-eyebrow">Systems Map</span>
          <a
            href="/systems-map"
            class="text-xs text-brand transition-colors hover:underline"
          >
            Open →
          </a>
        </div>
        <SystemMap class="max-w-sm" />
      </div>
    </div>
  </section>

  <!-- Entry points -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        entries.map((e) => (
          <a
            href={e.href}
            class="group flex flex-col rounded-lg border border-border bg-card p-5 transition-colors hover:border-brand/40"
          >
            <span class="atlas-eyebrow">{e.meta}</span>
            <h2 class="mt-2 text-lg font-semibold tracking-tight transition-colors group-hover:text-brand">
              {e.title}
            </h2>
            <p class="mt-1 flex-1 text-sm text-muted-foreground">
              {e.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
              {e.cta}
              <span
                aria-hidden="true"
                class="transition-transform group-hover:translate-x-0.5"
              >
                →
              </span>
            </span>
          </a>
        ))
      }
    </div>

    <a
      href="/search"
      class="group mt-4 flex items-center justify-between gap-4 rounded-lg border border-border bg-card p-5 transition-colors hover:border-brand/40"
    >
      <div>
        <h2 class="text-lg font-semibold tracking-tight transition-colors group-hover:text-brand">
          Search everything
        </h2>
        <p class="mt-1 text-sm text-muted-foreground">
          Jump straight to any concept, domain, decision or guide.
        </p>
      </div>
      <kbd
        class="hidden shrink-0 items-center rounded border border-border bg-muted px-2 py-1 font-mono text-xs text-muted-foreground sm:inline-flex"
      >
        <span class="mod-mac">⌘</span><span class="mod-other">Ctrl&nbsp;</span>K
      </kbd>
    </a>
  </section>

  <!-- Philosophy -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div
      class="rounded-xl border border-border border-l-2 border-l-brand bg-muted/30 p-6 sm:p-8"
    >
      <p class="atlas-eyebrow">The Atlas view</p>
      <p class="mt-3 max-w-3xl text-lg text-foreground">
        Production systems do not automatically need Redis, Kafka, Kubernetes or
        microservices. These solve specific problems and add real cost.
      </p>
      <p class="mt-3 max-w-3xl text-muted-foreground">
        The Atlas keeps one question in view for every optional technology:
        <span class="font-medium text-foreground">
          has the system actually earned this complexity?
        </span>
      </p>
    </div>
  </section>
</BaseLayout>
