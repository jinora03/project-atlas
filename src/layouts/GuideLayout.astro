---
import { render } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "@/components/atlas/Breadcrumbs.astro";
import DomainBadge from "@/components/atlas/DomainBadge.astro";
import type { GuideEntry } from "@/lib/content";
import { domainLinks } from "@/lib/content";

interface Props {
  entry: GuideEntry;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const domains = await domainLinks(entry.data.domains);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Guides", href: "/guides" },
        { label: entry.data.title },
      ]}
    />

    <header class="mt-6 max-w-3xl">
      <div class="flex items-center gap-2 atlas-eyebrow">
        <span>Guide</span>
        {
          entry.data.canonical && (
            <>
              <span aria-hidden="true" class="text-border">·</span>
              <span class="text-brand">canonical</span>
            </>
          )
        }
      </div>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">{entry.data.description}</p>
      {
        domains.length > 0 && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class="atlas-eyebrow mr-1">Covers</span>
            {domains.map((d) => (
              <DomainBadge label={d.label} href={d.href} />
            ))}
          </div>
        )
      }
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_14rem]">
      <article class="atlas-prose">
        <Content />
      </article>

      {
        toc.length > 0 && (
          <aside class="hidden lg:block">
            <div class="sticky top-20">
              <h2 class="atlas-eyebrow">On this page</h2>
              <ul class="mt-3 space-y-2 border-l border-border text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class:list={[
                        "-ml-px block border-l border-transparent py-0.5 text-muted-foreground transition-colors hover:border-brand hover:text-foreground",
                        h.depth === 2 ? "pl-3" : "pl-6",
                      ]}
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </aside>
        )
      }
    </div>

    <div class="mt-14 border-t border-border pt-8">
      <a
        href="/guides"
        class="text-sm text-brand transition-colors hover:underline"
      >
        ← All guides
      </a>
    </div>
  </div>
</BaseLayout>
