---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol
    class="flex flex-wrap items-center gap-1.5 font-mono text-xs text-muted-foreground"
  >
    {
      items.map((c, i) => {
        const last = i === items.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {c.href && !last ? (
              <a href={c.href} class="transition-colors hover:text-foreground">
                {c.label}
              </a>
            ) : (
              <span class={last ? "text-foreground" : undefined} aria-current={last ? "page" : undefined}>
                {c.label}
              </span>
            )}
            {!last && (
              <span aria-hidden="true" class="text-border">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
