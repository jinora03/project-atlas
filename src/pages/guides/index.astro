---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/atlas/PageHeader.astro";
import GuideCard from "@/components/atlas/GuideCard.astro";
import { getGuides, hrefFor } from "@/lib/content";

const guides = await getGuides();
const canonical = guides.find((g) => g.data.canonical);
const others = guides.filter((g) => !g.data.canonical);
---

<BaseLayout
  title="Guides"
  description="Long-form, connected explanations — understand an engineering area as a system."
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeader
      eyebrow="Browse"
      title="Guides"
      description="Sequential, coherent explanations. Where concepts explain one thing, a guide connects many into a single mental model."
    />

    {
      canonical && (
        <a
          href={hrefFor("guides", canonical.id)}
          class="group mt-12 block rounded-xl border border-border bg-card p-6 transition-colors hover:border-brand/40 sm:p-8"
        >
          <div class="flex items-center gap-2 atlas-eyebrow">
            <span>Guide</span>
            <span aria-hidden="true" class="text-border">·</span>
            <span class="text-brand">canonical</span>
          </div>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight transition-colors group-hover:text-brand">
            {canonical.data.title}
          </h2>
          <p class="mt-2 max-w-2xl text-muted-foreground">
            {canonical.data.description}
          </p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand">
            Read the guide
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
              →
            </span>
          </span>
        </a>
      )
    }

    {
      others.length > 0 && (
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((g) => (
            <GuideCard entry={g} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
