---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/atlas/PageHeader.astro";
import DomainCard from "@/components/atlas/DomainCard.astro";
import { getDomains } from "@/lib/content";

const domains = await getDomains();
---

<BaseLayout
  title="Domains"
  description="Engineering territories — navigate an area of software and the concepts relevant to it."
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeader
      eyebrow="Browse"
      title="Domains"
      description="Engineering territories. A domain is a place to orient yourself — it aggregates the concepts, guides and decisions relevant to an area without owning them."
    />

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {domains.map((d) => <DomainCard entry={d} />)}
    </div>

    <p class="mt-10 max-w-2xl text-sm text-muted-foreground">
      Only domains with real content appear here. Further domains are planned in
      the repository&rsquo;s <code class="rounded bg-muted px-1 py-0.5 font-mono text-xs">TAXONOMY.md</code>
      and will appear as their content lands.
    </p>
  </div>
</BaseLayout>
