---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/atlas/PageHeader.astro";
import SystemMap from "@/components/atlas/SystemMap.astro";
import { buttonVariants } from "@/components/ui/button";
import { getCanonicalGuide, hrefFor } from "@/lib/content";

const guide = await getCanonicalGuide();
---

<BaseLayout
  title="Systems Map"
  description="An orientation map of how a request travels through a software system — every node links to canonical Atlas content."
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <PageHeader
      eyebrow="Explore"
      title="Systems Map"
      description="A first orientation: how a request travels through a typical system, and where the major responsibilities live. Every node links into the Atlas."
    />

    <div class="mt-12 grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)]">
      <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start">
        <div class="rounded-lg border border-border bg-card p-5">
          <h2 class="atlas-eyebrow">How to read this</h2>
          <p class="mt-3 text-sm text-muted-foreground">
            This is an <strong class="font-medium text-foreground">orientation</strong>,
            not a blueprint. Real systems add, remove, merge and reorder these
            pieces. It exists to show where responsibilities tend to sit and how
            they connect.
          </p>
          <p class="mt-3 text-sm text-muted-foreground">
            Follow any node to its canonical concept, domain or guide.
          </p>
        </div>
        {
          guide && (
            <a
              href={hrefFor("guides", guide.id)}
              class={buttonVariants({ variant: "outline", size: "lg" }) + " w-full"}
            >
              Read the systems guide →
            </a>
          )
        }
      </aside>

      <div class="rounded-xl border border-border bg-muted/30 p-6 sm:p-10">
        <SystemMap />
      </div>
    </div>
  </div>
</BaseLayout>
