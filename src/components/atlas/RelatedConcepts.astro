---
import { resolveRelatedConcepts, hrefFor } from "@/lib/content";

interface Props {
  ids: string[];
  title?: string;
}
const { ids, title = "Related concepts" } = Astro.props;
const { resolved, missing } = await resolveRelatedConcepts(ids);
const hasAny = resolved.length > 0 || missing.length > 0;
---

{
  hasAny && (
    <section aria-label={title}>
      <h2 class="atlas-eyebrow">{title}</h2>
      {resolved.length > 0 && (
        <ul class="mt-3 divide-y divide-border overflow-hidden rounded-lg border border-border bg-card">
          {resolved.map((c) => (
            <li>
              <a
                href={hrefFor("concepts", c.id)}
                class="group flex flex-col gap-0.5 px-4 py-3 transition-colors hover:bg-accent"
              >
                <span class="text-sm font-medium transition-colors group-hover:text-brand">
                  {c.data.title}
                </span>
                <span class="line-clamp-1 text-xs text-muted-foreground">
                  {c.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {missing.length > 0 && (
        <p class="mt-2.5 flex flex-wrap items-center gap-1.5 text-xs text-muted-foreground">
          <span class="atlas-eyebrow">Planned</span>
          {missing.map((id) => (
            <span class="rounded-full border border-dashed border-border px-2 py-0.5 font-mono">
              {id}
            </span>
          ))}
        </p>
      )}
    </section>
  )
}
