---
const explore = [
  { label: "Systems Map", href: "/systems-map" },
  { label: "Systems Guide", href: "/guides" },
  { label: "Search", href: "/search" },
];
const browse = [
  { label: "Domains", href: "/domains" },
  { label: "Concepts", href: "/concepts" },
  { label: "Decisions", href: "/decisions" },
];
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-border">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr]"
  >
    <div class="max-w-xs">
      <div class="flex items-center gap-2.5">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-brand"
          aria-hidden="true"
        >
          <path d="M3 8c3-3 6-3 9 0s6 3 9 0"></path>
          <path d="M3 13c3-3 6-3 9 0s6 3 9 0"></path>
          <path d="M3 18c3-3 6-3 9 0s6 3 9 0"></path>
        </svg>
        <span class="font-semibold tracking-tight">Software Engineering Atlas</span>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">
        Understand how software systems fit together — where things belong, what
        they own, and when their complexity is justified.
      </p>
    </div>

    <nav aria-label="Explore">
      <h2 class="atlas-eyebrow">Explore</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          explore.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Browse">
      <h2 class="atlas-eyebrow">Browse</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          browse.map((l) => (
            <li>
              <a
                href={l.href}
                class="text-muted-foreground transition-colors hover:text-foreground"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-border">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p class="font-mono">Software Engineering Atlas · v0.1 · © {year}</p>
      <p class="font-mono">Content is canonical Markdown — this site is a presentation layer.</p>
    </div>
  </div>
</footer>
