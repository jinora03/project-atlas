---
import type { DecisionEntry } from "@/lib/content";
import { hrefFor } from "@/lib/content";

interface Props {
  entries: DecisionEntry[];
  title?: string;
}
const { entries, title = "Relevant decisions" } = Astro.props;
---

{
  entries.length > 0 && (
    <section aria-label={title}>
      <h2 class="atlas-eyebrow">{title}</h2>
      <ul class="mt-3 divide-y divide-border overflow-hidden rounded-lg border border-border bg-card">
        {entries.map((d) => (
          <li>
            <a
              href={hrefFor("decisions", d.id)}
              class="group flex flex-col gap-0.5 px-4 py-3 transition-colors hover:bg-accent"
            >
              <span class="text-sm font-medium transition-colors group-hover:text-brand">
                {d.data.question ?? d.data.title}
              </span>
              <span class="line-clamp-1 text-xs text-muted-foreground">
                {d.data.description}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
