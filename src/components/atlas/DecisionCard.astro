---
import type { DecisionEntry } from "@/lib/content";
import { domainLinks, hrefFor } from "@/lib/content";
import DomainBadge from "./DomainBadge.astro";

interface Props {
  entry: DecisionEntry;
}
const { entry } = Astro.props;
const href = hrefFor("decisions", entry.id);
const domains = await domainLinks(entry.data.domains);
---

<article
  class="group flex h-full flex-col gap-3 rounded-lg border border-border bg-card p-5 transition-colors hover:border-brand/40"
>
  <div
    class="font-mono text-[0.68rem] uppercase tracking-wider text-muted-foreground"
  >
    Decision
  </div>
  <h3 class="text-lg font-semibold tracking-tight">
    <a href={href} class="transition-colors group-hover:text-brand">
      {entry.data.question ?? entry.data.title}
    </a>
  </h3>
  <p class="line-clamp-3 text-sm text-muted-foreground">
    {entry.data.description}
  </p>
  {
    domains.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-1.5 pt-1">
        {domains.map((d) => (
          <DomainBadge label={d.label} href={d.href} />
        ))}
      </div>
    )
  }
</article>
